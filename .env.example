# ==========================================================
# AI Model Gateway Configuration
# ==========================================================

# Project Info
PROJECT_NAME="AI Model Gateway"
VERSION="1.0.0"

# Security
SECRET_KEY="replace_with_a_secure_random_string_at_least_32_characters"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database Configuration
# Local SQLite default (for immediate offline execution):
DATABASE_URL="sqlite+aiosqlite:///./ai_gateway.db"
# Or Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://gateway_user:gateway_secure_password_123@localhost:5432/ai_gateway"

# Redis Configuration (Optional, falls back to in-memory sliding window)
REDIS_URL=""
# REDIS_URL="redis://localhost:6379/0"

# CORS Configuration
CORS_ORIGINS="*"

# Gateway Concurrency & Rate Limiting (Optimized for Apple M5 16 GB Unified Memory)
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_MONTHLY_TOKEN_LIMIT=10000000
DEFAULT_MAX_CONCURRENT_REQUESTS=4
DEFAULT_QUEUE_TIMEOUT_SECONDS=30.0
DEFAULT_REQUEST_TIMEOUT_SECONDS=300.0

# Per-Backend Concurrency Limits (Protects 16 GB RAM boundary)
OLLAMA_CONCURRENCY=2
LLAMACPP_CONCURRENCY=1
MLX_CONCURRENCY=2

# Resilience, Retries & Timeouts
MAX_RETRIES=2
RETRY_BACKOFF_FACTOR=0.5
PROVIDER_TIMEOUT_SECONDS=120.0
MODEL_IDLE_TIMEOUT_SECONDS=300

# Defaults
DEFAULT_MODEL=universal
DEFAULT_CONTEXT_SIZE=8192

# Privacy
# When false, prompt content and model responses are NEVER stored in logs or database
STORE_REQUEST_CONTENT=false

# Bootstrap Credentials
FIRST_ADMIN_EMAIL="admin@example.com"
FIRST_ADMIN_PASSWORD="admin123456"
FIRST_ADMIN_NAME="System Admin"
GATEWAY_API_KEY=""

# Internal Model Endpoints on Apple Silicon M5
OLLAMA_BASE_URL="http://127.0.0.1:11434"
MLX_BASE_URL="http://127.0.0.1:8081"
LLAMACPP_BASE_URL="http://127.0.0.1:8082"

